# Paste the /exec URL from your Apps Script Web App deployment.
# Example: https://script.google.com/macros/s/AKfycb.../exec
#
# This URL is per-deployment and changes whenever you create a NEW deployment
# (it stays the same when you publish a new VERSION of an existing deployment).
# The backend is pinned to the Google Sheet identified by SHEET_ID inside
# apps-script/Code.gs — see ./apps-script/README.md for full steps.
#VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwgetiAZslV1tbXfksY4TsCkHXoLvGVpqyqMIjv4d_RB41ZVoE3Zm-dQKyEq6TQNL0W/exec 

# Copy this file to .env and fill in your values

# The Sheet ID from your AIC Inventory App spreadsheet URL.
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=1CXjabXedktYGcTPbKB-BGspeRXNOvML6u3wBeqln8VE

# Path to the service account JSON key file.
# Create a service account in Google Cloud Console, download the key, save it
# at server/credentials/sa.json (or any path you choose), then share your
# spreadsheet with the service account email (Editor access).
GOOGLE_APPLICATION_CREDENTIALS=./credentials/sa.json

# Server port (optional)
PORT=4000
